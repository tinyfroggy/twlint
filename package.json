{
  "name": "twlinter",
  "version": "0.1.2",
  "type": "module",
  "description": "CLI for scanning projects and reporting non-canonical Tailwind CSS classes",
  "bin": {
    "twlinter": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "prepare": "husky",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ tests/",
    "format": "oxfmt src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "cli",
    "tailwind",
    "lint",
    "tailwindcss",
    "diagnostics",
    "developer-tools"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyfroggy/twlint.git"
  },
  "homepage": "https://github.com/tinyfroggy/twlint#readme",
  "bugs": {
    "url": "https://github.com/tinyfroggy/twlint/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/language-service": "^0.14.29",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^4.2.2",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.59.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}

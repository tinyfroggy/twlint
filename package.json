{
  "name": "cli-tw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI experiment for Tailwind canonical class linting",
  "packageManager": "bun@1.2.10",
  "bin": {
    "cli-tw": "./dist/cli.js",
    "tw": "./dist/cli.js",
    "tw-lint": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ tests/",
    "format": "oxfmt src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "keywords": [
    "cli",
    "tailwind",
    "lint"
  ],
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/language-service": "^0.14.29",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^4.2.2",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
